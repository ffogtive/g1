app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 게임 파일은 tool/sync_web.sh로 복사해 넣는다 (원본: kungkung/real.html, kungkung/real/)
/assets/web/**
!/assets/web/**/
!/assets/web/**/.gitkeep

# 아이폰 설치 스크립트(tool/deploy-iphone.command)의 빌드·로그, 개인 설정(팀·기기 ID)은 깃에 올리지 않는다
/.local/
/tool/deploy.local
